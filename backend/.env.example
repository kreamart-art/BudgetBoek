# Verplicht: lange willekeurige string. Genereer er een met:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In productie (NODE_ENV=production) minimaal 32 tekens.
JWT_SECRET=verander-mij-in-een-lange-willekeurige-string

# Poort waarop de server draait
PORT=4000

# Toegestane frontend-oorsprong(en), komma-gescheiden. Gebruik in productie geen *.
# Bijvoorbeeld de dev-server van Vite, of je Vercel-domein:
CORS_ORIGIN=http://localhost:5173

# Zet op 'production' om de hardening-checks te activeren (sterk geheim, geen * CORS).
# NODE_ENV=production

# Achter een reverse proxy (Coolify/Caddy/Nginx/Vercel)? Aantal proxies dat de
# echte client-IP doorgeeft — nodig voor correcte rate-limiting. Bijv. 1, of 'true'.
# TRUST_PROXY=1

# --- Database ---
# DB_DRIVER=sqlite (standaard) of postgres.
# Zonder DB_DRIVER maar mét DATABASE_URL wordt automatisch Postgres gekozen.
# DB_DRIVER=sqlite

# SQLite: pad naar het bestand (alleen bij DB_DRIVER=sqlite)
# DB_FILE=budget.db

# Postgres: óf een volledige connectiestring (zo levert Coolify/Heroku 'm aan)…
# DATABASE_URL=postgres://gebruiker:wachtwoord@host:5432/budgetboek
# …óf losse onderdelen:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=budget
# PGPASSWORD=geheim
# PGDATABASE=budgetboek
# Zet PGSSL=require als je Postgres TLS vereist (veel managed providers):
# PGSSL=require

# --- Pushberichten (web-push) ---
# Genereer eenmalig een sleutelpaar met:
#   npx web-push generate-vapid-keys
# en plak de waarden hieronder. Laat ze leeg om push uit te zetten.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contactadres dat aan de pushdienst wordt doorgegeven (mailto: of https-URL):
VAPID_SUBJECT=mailto:jij@voorbeeld.nl

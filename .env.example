# Docker Compose (self-hosted) — kopieer naar `.env` naast docker-compose.yml.
# (Voor Coolify/Vercel gebruik je dit bestand niet; zet de variabelen daar in de UI.)

# Domeinen die Caddy bedient (automatische HTTPS). Wijs ze met DNS naar je server.
APP_DOMAIN=app.jouwdomein.nl
API_DOMAIN=api.jouwdomein.nl

# Sterk JWT-geheim (min. 32 tekens in productie):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Toegestane frontend-origin (geen *). Moet matchen met APP_DOMAIN:
CORS_ORIGIN=https://app.jouwdomein.nl

# Build-time URL voor de frontend (Vite bakt 'm in). Moet matchen met API_DOMAIN:
VITE_API_URL=https://api.jouwdomein.nl

# Postgres-wachtwoord (de stack draait Postgres in een container met een volume):
POSTGRES_PASSWORD=

# Pushberichten (optioneel): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jij@jouwdomein.nl
